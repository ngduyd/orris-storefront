# Database — the only place the app looks for it.
#   local dev (db container published on 5434): postgres://shopify:shopify@127.0.0.1:5434/shopify
#   compose prod (app talks to the db service): postgres://shopify:<POSTGRES_PASSWORD>@db:5432/shopify
#   external/managed:                           postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgres://shopify:shopify@127.0.0.1:5434/shopify
#   managed (Supabase): runtime uses the transaction pooler, migrations need the direct/session URL:
#   runtime     postgres://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   migrations  postgres://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Cloudinary (image CDN)
CLOUDINARY_CLOUD=your-cloud-name

# SMTP (nodemailer)
SMTP_URL=smtp://user:pass@smtp.example.com:587
# OR individual fields:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user
SMTP_PASS=password
MAIL_FROM=ORRIS <no-reply@example.com>

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Checkout guard: when "true", an account with an unverified email (and no Google
# provider) cannot place an order. Default off.

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secure-password

# NODE_ENV, PORT and HOSTNAME are set by the image; only needed when running `next` directly.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0

# Postgres for the compose stack (defaults to shopify when empty)
POSTGRES_USER=shopify
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopify

# Image uploads from the admin: signed Cloudinary upload when set,
# otherwise files go to web/public/uploads (dev only, gitignored).
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- storefront ---
# Flat shipping in SAR minor units (0 = free shipping). FREE_SHIPPING_OVER_MINOR cancels it above a subtotal.
SHIPPING_FLAT_MINOR=0
FREE_SHIPPING_OVER_MINOR=0
# Public base URL, used by sitemap.xml and robots.txt in production
SITE_URL=http://localhost:3000
# Refuse checkout until the email is confirmed (google accounts are always verified)
REQUIRE_VERIFIED_EMAIL=false
