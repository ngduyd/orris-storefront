# Database
DATABASE_URL=postgres://shopify:shopify@localhost:5434/shopify

# Cloudinary (image CDN)
CLOUDINARY_CLOUD=your-cloud-name

# SMTP (nodemailer)
SMTP_URL=smtp://user:pass@smtp.example.com:587
# OR individual fields:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user
SMTP_PASS=password
MAIL_FROM=ORRIS <no-reply@example.com>

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secure-password

# --- container / compose (docker-compose.prod.yml) ---
# NODE_ENV, PORT, HOSTNAME do image set sẵn; chỉ đặt khi chạy `next` trực tiếp.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0

# Postgres cho stack compose (compose tự mặc định shopify nếu bỏ trống)
POSTGRES_USER=shopify
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopify
